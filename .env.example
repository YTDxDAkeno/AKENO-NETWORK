# AKENO NETWORK configuration.
# Copy this file to .env and replace every placeholder. Never commit real secrets.

# ---------------------------------------------------------------------------
# Local development (pnpm dev)
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection used by the API (local dev uses compose.dev.yaml or a local server).
DATABASE_URL=postgres://akeno:change-me-local-dev-password@127.0.0.1:5432/akeno_dev
DB_POOL_MAX=10

# Origin the browser uses to reach the app. In development this is the Vite dev server.
PUBLIC_ORIGIN=http://localhost:5173
# Optional extra origins (comma separated), e.g. a LAN address: http://192.168.1.20:5173
ADDITIONAL_ORIGINS=

# invite = registration requires an invitation code (default, recommended)
# open   = anyone who can reach the site may register (development only)
REGISTRATION_MODE=invite

# Reverse proxy trust. "false" when the API is reached directly.
# Behind Caddy in Docker Compose use: loopback,uniquelocal
TRUST_PROXY=false

# Session lifetime (absolute) and idle timeout, in days.
SESSION_TTL_DAYS=30
SESSION_IDLE_TIMEOUT_DAYS=7
# Paired devices (console/companion clients): token lifetime and idle timeout in days.
DEVICE_TOKEN_TTL_DAYS=180
DEVICE_TOKEN_IDLE_DAYS=30
# auto = Secure cookies when PUBLIC_ORIGIN uses https
COOKIE_SECURE=auto

# Argon2id parameters (OWASP minimum recommendation: m=19456 KiB, t=2, p=1).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENCY=4

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_MINUTE=300

# Apply migrations automatically on startup (the Docker image sets this to true).
MIGRATE_ON_START=false

# Uploaded images (profile pictures, banners, game artwork). Docker Compose uses the media-data
# volume at /data/media; include it in backups (infrastructure/scripts/backup.sh does).
MEDIA_DIR=./data/media
MEDIA_MAX_TOTAL_MB=2048
MEDIA_MIN_FREE_MB=512
MEDIA_PROCESSING_CONCURRENCY=1

# ---------------------------------------------------------------------------
# Docker Compose (compose.yaml)
# ---------------------------------------------------------------------------
# Database password for the bundled PostgreSQL container. Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Public URL of your deployment (HTTPS in production).
AKENO_PUBLIC_ORIGIN=https://akeno.example.com
# Domain Caddy requests a certificate for (must point to your server via DNS).
AKENO_DOMAIN=akeno.example.com
# Address the app container port is published on (keep 127.0.0.1 behind Caddy).
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# ---------------------------------------------------------------------------
# Party voice chat (optional, Alpha 0.4) — see docs/VOICE.md before enabling
# ---------------------------------------------------------------------------
# Leave all three empty to keep voice off (parties then say voice is unavailable).
# Start the LiveKit server with: docker compose --profile https --profile voice up -d
# LiveKit needs 7881/tcp and 7882/udp reachable from the internet (firewall changes are yours
# to make; nothing in this project changes the firewall).
#
# What browsers connect to. Behind Caddy: wss://<AKENO_DOMAIN>/livekit
# Local HTTP setup without Caddy: ws://localhost:7880
LIVEKIT_URL=
# How the app reaches LiveKit's API. Compose default: http://livekit:7880 (leave empty there).
# For `pnpm dev` with a local LiveKit: http://127.0.0.1:7880
LIVEKIT_API_URL=
# API key and secret shared by the app and LiveKit. Generate them, for example:
#   LIVEKIT_API_KEY=akeno$(openssl rand -hex 4)   LIVEKIT_API_SECRET=$(openssl rand -hex 32)
# Letters and digits only; the secret must be at least 32 characters.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lifetime of a voice join token in seconds (30-600). Short on purpose: it is only needed to join.
VOICE_TOKEN_TTL_SECONDS=120
# Compose voice profile only: the server's public IPv4 address advertised to browsers for media.
# Leave empty to let LiveKit discover it over STUN (LIVEKIT_USE_EXTERNAL_IP=true).
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=true
