+/* AKENO direct entry, root mode, end to end with a real document: the steps
+ * the ShellUI hooks run (direct_entry.hpp), against the real registry,
+ * renderer, dynamic page stack and ToolboxUiState. */
+int test_direct_entry_flow(void) {
+  namespace dyn = onion::shellui::dynamic_ui;
+  namespace de = toolbox::direct_entry;
+  constexpr const char *kRoot = "debug_settings.xml";
+  constexpr const char *kToolboxUri = "pssettings:play?function=debug_settings_old";
+  char dir_template[] = "/tmp/onion-direct-flow-XXXXXX";
+  const std::string dir = mkdtemp(dir_template) ? dir_template : "";
+  TEST_ASSERT_TRUE(!dir.empty());
+
+  onion::plugin_ui::Registry registry;
+  const auto registered = registry.register_encoded("TEST00001", make_document());
+  TEST_ASSERT_TRUE(registered.status == onion::plugin_ui::Status::Ok);
+  dyn::configure(0x12200000); /* the owner's firmware */
+  dyn::replace_snapshot(registry.snapshot());
+  dyn::set_action_sink(flow_sink, nullptr);
+  const onion::plugin_ui::Document &doc =
+      *registry.snapshot().find(registered.handle)->document;
+  const std::string advanced = dyn::resource_name(doc, "advanced");
+  const std::string enabled_id = dyn::control_id(doc, "enabled");
+  const std::string reload_id = dyn::control_id(doc, "reload");
+
+  onion::Settings settings{};
+  settings.toolbox_shortcut_target = "TEST00001";
+  settings.toolbox_target_mode = onion::kToolboxTargetRoot;
+  de::Session session(dir);
+  session.start(61, 1000);
+  ToolboxUiState ui;
+  uint64_t now = 100000;
+
+  for (int round = 0; round < 25; ++round, now += 10000) {
+    /* 1. Shortcut -> URI -> boot redirect. */
+    { const std::string got_ = de::shortcut_uri(session, "l2_r3", settings, kToolboxUri, now); TEST_ASSERT_STREQ("OnionHEN?Plugin=TEST00001", got_.c_str()); }
+    TEST_ASSERT_TRUE(de::shortcut_uri(session, "l2_r3", settings, kToolboxUri, now + 10).empty());
+    ui.cheats_shortcut_activated = true; /* a stale flag must not win */
+    de::accept_plugin_uri(session, ui, "TEST00001", settings, now + 50);
+    TEST_ASSERT_TRUE(!ui.any_cheat_shortcut());
+
+    /* 2. Unrelated resources before the root are untouched. */
+    std::string xml;
+    TEST_ASSERT_TRUE(!de::serve_plugin_page(session, ui, "payloads.xml", kRoot, xml, now + 60));
+    TEST_ASSERT_TRUE(xml.empty());
+
+    /* 3. The Settings root is the plugin's root page. */
+    TEST_ASSERT_TRUE(de::serve_plugin_page(session, ui, kRoot, kRoot, xml, now + 100));
+    TEST_ASSERT_TRUE(xml.find("<setting_list id=\"id_debug_settings\"") != std::string::npos);
+    TEST_ASSERT_TRUE(xml.find(enabled_id) != std::string::npos);
+    TEST_ASSERT_EQ_INT(static_cast<int>(toolbox::Page::DynamicPlugin),
+                       static_cast<int>(ui.active_page));
+    TEST_ASSERT_TRUE(ui.parent_pages.empty());
+    TEST_ASSERT_EQ_U64(1, dyn::page_depth());
+    TEST_ASSERT_TRUE(session.open());
+    session.page_activated(0, now + 200);
+
+    /* 4. A press on the root goes to the plugin. */
+    TEST_ASSERT_TRUE(de::press_plugin_control(session, enabled_id, "0", now + 300) ==
+                     dyn::DispatchResult::Accepted);
+    TEST_ASSERT_STREQ("enabled", g_flow_pressed.c_str());
+    TEST_ASSERT_TRUE(de::press_plugin_control(session, reload_id, "", now + 310) ==
+                     dyn::DispatchResult::NotOwned);
+
+    /* 5. A subpage, its press, back to the root. */
+    TEST_ASSERT_TRUE(de::serve_plugin_page(session, ui, advanced, kRoot, xml, now + 400));
+    TEST_ASSERT_EQ_U64(2, dyn::page_depth());
+    TEST_ASSERT_TRUE(de::press_plugin_control(session, reload_id, "", now + 500) ==
+                     dyn::DispatchResult::Accepted);
+    TEST_ASSERT_STREQ("reload", g_flow_pressed.c_str());
+    de::leave_plugin_page(session, ui, now + 600);
+    TEST_ASSERT_EQ_U64(1, dyn::page_depth());
+    TEST_ASSERT_TRUE(session.open());
+    TEST_ASSERT_EQ_INT(static_cast<int>(toolbox::Page::DynamicPlugin),
+                       static_cast<int>(ui.active_page));
+
+    if (round % 2 == 0) {
+      /* 6. Back on the root: Settings closes, nothing is left behind. */
+      de::leave_plugin_page(session, ui, now + 700);
+      TEST_ASSERT_EQ_U64(0, dyn::page_depth());
+    } else {
+      /* 6'. Settings closed without a pop (e.g. the PS button): the next
+       * Settings root drops the stale page and ends the session. */
+      TEST_ASSERT_TRUE(!de::serve_plugin_page(session, ui, kRoot, kRoot, xml, now + 700));
+      TEST_ASSERT_EQ_U64(0, dyn::page_depth());
+      ui.set_active_page(toolbox::Page::DebugSettings); /* the Toolbox route */
+    }
+    TEST_ASSERT_TRUE(!session.open());
+    TEST_ASSERT_TRUE(!de::read_text(session.session_file(), xml));
+    TEST_ASSERT_TRUE(ui.active_page != toolbox::Page::DynamicPlugin);
+    TEST_ASSERT_TRUE(ui.parent_pages.empty());
+  }
+
+  /* 7. The Toolbox route (F0) through the Plugins page is unchanged. */
+  std::string xml;
+  TEST_ASSERT_TRUE(!de::serve_plugin_page(session, ui, kRoot, kRoot, xml, now));
+  ui.set_active_page(toolbox::Page::DebugSettings);
+  ui.set_active_page(toolbox::Page::Plugins);
+  TEST_ASSERT_TRUE(de::serve_plugin_page(session, ui, dyn::resource_name(doc, "main"),
+                                         kRoot, xml, now + 100));
+  TEST_ASSERT_TRUE(xml.find("id_debug_settings") == std::string::npos);
+  TEST_ASSERT_TRUE(!session.open());
+  de::leave_plugin_page(session, ui, now + 200);
+  TEST_ASSERT_EQ_INT(static_cast<int>(toolbox::Page::Plugins),
+                     static_cast<int>(ui.active_page));
+
+  /* 8. The daemon disconnects mid-session (the bridge publishes an empty
+   * snapshot): presses go to Settings, leaving the page ends the session. */
+  now += 20000;
+  { const std::string got_ = de::shortcut_uri(session, "l2_r3", settings, kToolboxUri, now); TEST_ASSERT_STREQ("OnionHEN?Plugin=TEST00001", got_.c_str()); }
+  de::accept_plugin_uri(session, ui, "TEST00001", settings, now);
+  TEST_ASSERT_TRUE(de::serve_plugin_page(session, ui, kRoot, kRoot, xml, now + 100));
+  dyn::replace_snapshot({});
+  TEST_ASSERT_EQ_U64(0, dyn::page_depth());
+  TEST_ASSERT_TRUE(de::press_plugin_control(session, enabled_id, "1", now + 200) ==
+                   dyn::DispatchResult::NotOwned);
+  de::leave_plugin_page(session, ui, now + 300);
+  TEST_ASSERT_TRUE(!session.open());
+  TEST_ASSERT_EQ_INT(static_cast<int>(toolbox::Page::None),
+                     static_cast<int>(ui.active_page));
+
+  /* 9. Plugin not running: the shortcut and a pending URI both end on the
+   * Toolbox root. */
+  now += 20000;
+  { const std::string got_ = de::shortcut_uri(session, "l2_r3", settings, kToolboxUri, now); TEST_ASSERT_STREQ(kToolboxUri, got_.c_str()); }
+  de::accept_plugin_uri(session, ui, "TEST00001", settings, now);
+  TEST_ASSERT_TRUE(!de::serve_plugin_page(session, ui, kRoot, kRoot, xml, now + 100));
+  TEST_ASSERT_TRUE(!session.open());
+
+  /* 10. A SceShellUI restart in the middle of a session: the next one has
+   * root mode off, and the shortcut opens the Toolbox even with a page. */
+  dyn::replace_snapshot(registry.snapshot());
+  now += 20000;
+  { const std::string got_ = de::shortcut_uri(session, "l2_r3", settings, kToolboxUri, now); TEST_ASSERT_STREQ("OnionHEN?Plugin=TEST00001", got_.c_str()); }
+  de::accept_plugin_uri(session, ui, "TEST00001", settings, now);
+  TEST_ASSERT_TRUE(de::serve_plugin_page(session, ui, kRoot, kRoot, xml, now + 100));
+  de::Session restarted(dir);
+  restarted.start(99, now + 13000);
+  TEST_ASSERT_TRUE(restarted.disabled());
+  { const std::string got_ = de::shortcut_uri(restarted, "l2_r3", settings, kToolboxUri, now + 20000); TEST_ASSERT_STREQ(kToolboxUri, got_.c_str()); }
+  ToolboxUiState fresh;
+  de::accept_plugin_uri(restarted, fresh, "TEST00001", settings, now + 20000);
+  TEST_ASSERT_TRUE(!de::serve_plugin_page(restarted, fresh, kRoot, kRoot, xml, now + 20100));
+
+  dyn::replace_snapshot({});
+  dyn::set_action_sink(nullptr, nullptr);
+  unlink(restarted.disabled_file().c_str());
+  unlink(restarted.session_file().c_str());
+  rmdir(dir.c_str());
+  return 0;
+}
