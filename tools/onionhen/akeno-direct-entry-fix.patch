+/* 6, 10, 11: the session file follows the session; the input watch is
+ * bounded. */
+int test_session_file_and_watch() {
+  const std::string dir = make_dir();
+  Session session(dir);
+  session.start(4242, 100);
+  TEST_ASSERT_TRUE(!session.watching());
+  TEST_ASSERT_TRUE(session.on_plugin_uri("AKEN00001", true, 1000));
+  { const std::string got_ = session.take_root(kRoot, kRoot, 1100); TEST_ASSERT_STREQ("AKEN00001", got_.c_str()); }
+  session.root_served("AKEN00001", 1150);
+  TEST_ASSERT_TRUE(session.open());
+  TEST_ASSERT_TRUE(exists(session.session_file()));
+  std::string text;
+  TEST_ASSERT_TRUE(de::read_text(session.session_file(), text));
+  de::SessionRecord record;
+  TEST_ASSERT_TRUE(de::parse_record(text, record));
+  TEST_ASSERT_EQ_INT(4242, record.pid);
+  TEST_ASSERT_STREQ("root_served", record.stage.c_str());
+  TEST_ASSERT_STREQ("AKEN00001", record.plugin.c_str());
+  TEST_ASSERT_EQ_U64(1150, record.served_ms);
+
+  session.page_activated(1, 1200);
+  session.navigated(2, 3000);
+  session.pressed("sent to the plugin", 2, 4000);
+  TEST_ASSERT_TRUE(de::read_text(session.session_file(), text));
+  TEST_ASSERT_TRUE(de::parse_record(text, record));
+  TEST_ASSERT_STREQ("active", record.stage.c_str());
+  TEST_ASSERT_EQ_U64(4000, record.activity_ms);
+  session.popped(1, 5000);
+  TEST_ASSERT_TRUE(session.open());
+  session.popped(0, 6000);
+  TEST_ASSERT_TRUE(!session.open());
+  TEST_ASSERT_TRUE(!exists(session.session_file()));
+
+  /* Watch: one report per interval, then it stops by itself. */
+  TEST_ASSERT_TRUE(session.watching());
+  uint64_t now = 6000;
+  for (int i = 0; i < 4000 && session.watching(); ++i, now += 16)
+    session.pad_frame(static_cast<uint32_t>((i / 30) & 1), now);
+  TEST_ASSERT_TRUE(!session.watching());
+  TEST_ASSERT_TRUE(now <= 6000 + de::kWatchWindowMs + de::kWatchIntervalMs + 32);
+  /* Popping a page outside a session changes nothing. */
+  session.popped(0, now);
+  TEST_ASSERT_TRUE(!session.watching());
+  remove_dir(dir);
+  return 0;
+}
