+/* 2, 9: a pending request takes the Settings root exactly once, and no other
+ * resource. */
+int test_pending_taken_once() {
+  const std::string dir = make_dir();
+  Session session(dir);
+  TEST_ASSERT_TRUE(session.on_plugin_uri("AKEN00001", true, 1000));
+  TEST_ASSERT_TRUE(session.take_root("payloads.xml", kRoot, 1100).empty());
+  TEST_ASSERT_TRUE(session.take_root(kRoot, "", 1100).empty());
+  { const std::string got_ = session.take_root(kRoot, kRoot, 1200); TEST_ASSERT_STREQ("AKEN00001", got_.c_str()); }
+  TEST_ASSERT_TRUE(session.take_root(kRoot, kRoot, 1300).empty());
+  /* Link mode never arms the root. */
+  TEST_ASSERT_TRUE(!session.on_plugin_uri("AKEN00001", false, 2000));
+  TEST_ASSERT_TRUE(session.take_root(kRoot, kRoot, 2100).empty());
+  remove_dir(dir);
+  return 0;
+}
