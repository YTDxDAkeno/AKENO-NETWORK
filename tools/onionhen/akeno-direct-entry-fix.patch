+/* Another Settings root, or a new request, ends an open session. */
+int test_session_replaced() {
+  const std::string dir = make_dir();
+  Session session(dir);
+  TEST_ASSERT_TRUE(session.on_plugin_uri("AKEN00001", true, 1000));
+  { const std::string got_ = session.take_root(kRoot, kRoot, 1100); TEST_ASSERT_STREQ("AKEN00001", got_.c_str()); }
+  session.root_served("AKEN00001", 1100);
+  TEST_ASSERT_TRUE(session.take_root(kRoot, kRoot, 9000).empty());
+  TEST_ASSERT_TRUE(!session.open());
+  TEST_ASSERT_TRUE(!exists(session.session_file()));
+
+  TEST_ASSERT_TRUE(session.on_plugin_uri("AKEN00001", true, 20000));
+  { const std::string got_ = session.take_root(kRoot, kRoot, 20100); TEST_ASSERT_STREQ("AKEN00001", got_.c_str()); }
+  session.root_served("AKEN00001", 20100);
+  TEST_ASSERT_TRUE(session.on_plugin_uri("AKEN00001", true, 30000));
+  TEST_ASSERT_TRUE(!session.open());
+  { const std::string got_ = session.take_root(kRoot, kRoot, 30100); TEST_ASSERT_STREQ("AKEN00001", got_.c_str()); }
+  session.root_failed("AKEN00001", "test");
+  TEST_ASSERT_TRUE(!session.open());
+  TEST_ASSERT_TRUE(!exists(session.session_file()));
+  remove_dir(dir);
+  return 0;
+}
