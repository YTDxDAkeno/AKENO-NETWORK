+/* 9: a repeated shortcut is one request; a later one is a new request. */
+int test_duplicate_shortcut_ignored() {
+  const std::string dir = make_dir();
+  Session session(dir);
+  TEST_ASSERT_EQ_INT(static_cast<int>(ShortcutAction::PluginRoot),
+                     static_cast<int>(session.on_shortcut("l2_r3", "AKEN00001", true, true, 10000)));
+  TEST_ASSERT_EQ_INT(static_cast<int>(ShortcutAction::Ignore),
+                     static_cast<int>(session.on_shortcut("share", "AKEN00001", true, true, 10500)));
+  TEST_ASSERT_EQ_INT(static_cast<int>(ShortcutAction::Ignore),
+                     static_cast<int>(session.on_shortcut("l2_r3", "AKEN00001", true, true, 11999)));
+  TEST_ASSERT_EQ_INT(static_cast<int>(ShortcutAction::PluginRoot),
+                     static_cast<int>(session.on_shortcut("l2_r3", "AKEN00001", true, true, 12000)));
+  /* Link mode and the empty target never reach the duplicate check. */
+  TEST_ASSERT_EQ_INT(static_cast<int>(ShortcutAction::Toolbox),
+                     static_cast<int>(session.on_shortcut("l2_r3", "AKEN00001", false, true, 12001)));
+  TEST_ASSERT_EQ_INT(static_cast<int>(ShortcutAction::Toolbox),
+                     static_cast<int>(session.on_shortcut("l2_r3", "", true, true, 12002)));
+  remove_dir(dir);
+  return 0;
+}
