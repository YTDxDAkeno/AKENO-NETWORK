+/* 4, 6: the Settings root owns no parent; a linked plugin page does. */
+int test_settings_root_page_ownership() {
+  ToolboxUiState linked;
+  linked.set_active_page(toolbox::Page::DebugSettings);
+  linked.set_active_page(toolbox::Page::Plugins);
+  linked.set_active_page(toolbox::Page::DynamicPlugin);
+  TEST_ASSERT_EQ_U64(1, linked.parent_pages.size());
+  linked.leave_page(toolbox::Page::DynamicPlugin);
+  TEST_ASSERT_EQ_INT(static_cast<int>(toolbox::Page::Plugins),
+                     static_cast<int>(linked.active_page));
+
+  ToolboxUiState root;
+  root.set_active_page(toolbox::Page::Plugins);
+  root.set_active_page(toolbox::Page::DynamicPlugin); /* an earlier session */
+  root.active_plugin = "kstuff";
+  root.cheats_shortcut_activated = true;
+  root.enter_settings_root(toolbox::Page::DynamicPlugin);
+  TEST_ASSERT_TRUE(root.parent_pages.empty());
+  TEST_ASSERT_EQ_INT(static_cast<int>(toolbox::Page::None),
+                     static_cast<int>(root.parent_page));
+  TEST_ASSERT_TRUE(root.active_plugin.empty());
+  TEST_ASSERT_TRUE(!root.any_cheat_shortcut());
+  /* A child page and back keep the root; leaving the root restores nothing. */
+  root.set_active_page(toolbox::Page::DynamicPlugin);
+  TEST_ASSERT_TRUE(root.parent_pages.empty());
+  root.leave_page(toolbox::Page::DynamicPlugin);
+  TEST_ASSERT_EQ_INT(static_cast<int>(toolbox::Page::None),
+                     static_cast<int>(root.active_page));
+  return 0;
+}
