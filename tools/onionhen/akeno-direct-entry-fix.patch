+/* 8: an interrupted request does not outlive its Settings opening. */
+int test_pending_expires_or_is_cancelled() {
+  const std::string dir = make_dir();
+  Session session(dir);
+  TEST_ASSERT_TRUE(session.on_plugin_uri("AKEN00001", true, 1000));
+  TEST_ASSERT_TRUE(session.take_root(kRoot, kRoot, 1000 + de::kPendingTtlMs + 1).empty());
+  TEST_ASSERT_TRUE(session.take_root(kRoot, kRoot, 1000 + de::kPendingTtlMs + 2).empty());
+  TEST_ASSERT_TRUE(session.on_plugin_uri("AKEN00001", true, 50000));
+  { const std::string got_ = session.take_root(kRoot, kRoot, 50000 + de::kPendingTtlMs); TEST_ASSERT_STREQ("AKEN00001", got_.c_str()); }
+  const char *routes[] = {"OnionHEN?Cheats", "OnionHEN?Cheats_not_open",
+                          "OnionHEN?DL_UPDATE", "the HomeUI OnionHEN entry"};
+  for (const char *route : routes) {
+    TEST_ASSERT_TRUE(session.on_plugin_uri("AKEN00001", true, 60000));
+    session.cancel_pending(route);
+    TEST_ASSERT_TRUE(session.take_root(kRoot, kRoot, 60001).empty());
+  }
+  remove_dir(dir);
+  return 0;
+}
