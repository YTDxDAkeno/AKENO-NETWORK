+/* AKENO direct entry (direct_entry.hpp): the session that keeps
+ * toolbox_target_mode=root from outliving its Settings session, the Settings
+ * root's page ownership, and the config keys. The page flow with a real plugin
+ * document is plugin_ui_direct_entry_flow in test_plugin_ui.cpp. */
+#include "test_harness.h"
+
+#include "direct_entry.hpp"
+#include "dynamic_ui_runtime.hpp"
+#include "shellui_state.hpp"
+#include "toolbox_route.hpp"
+
+#include <onion/settings.hpp>
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <sys/stat.h>
+#include <thread>
+#include <unistd.h>
