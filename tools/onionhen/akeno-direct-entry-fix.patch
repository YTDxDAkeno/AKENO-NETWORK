+/* 10, 11: a SceShellUI that ends during a direct-entry session turns root mode
+ * off for the boot; the shortcut is the Toolbox again. */
+int test_restart_during_session_disables_root_mode() {
+  const std::string dir = make_dir();
+  {
+    Session before(dir);
+    before.start(61, 90000);
+    TEST_ASSERT_TRUE(before.on_plugin_uri("AKEN00001", true, 170000));
+    { const std::string got_ = before.take_root(kRoot, kRoot, 170900); TEST_ASSERT_STREQ("AKEN00001", got_.c_str()); }
+    before.root_served("AKEN00001", 170927);
+    /* The process ends here: no pop, no cleanup. */
+  }
+  TEST_ASSERT_TRUE(exists(dir + "/" + std::string(de::kSessionFileName)));
+  Session after(dir);
+  after.start(99, 183804);
+  TEST_ASSERT_TRUE(after.disabled());
+  TEST_ASSERT_TRUE(!exists(after.session_file()));
+  TEST_ASSERT_TRUE(exists(after.disabled_file()));
+  std::string reason;
+  TEST_ASSERT_TRUE(de::read_text(after.disabled_file(), reason));
+  TEST_ASSERT_TRUE(reason.find("pid=61") != std::string::npos);
+  TEST_ASSERT_EQ_INT(static_cast<int>(ShortcutAction::Toolbox),
+                     static_cast<int>(after.on_shortcut("l2_r3", "AKEN00001", true, true, 200000)));
+  TEST_ASSERT_TRUE(!after.on_plugin_uri("AKEN00001", true, 200100));
+  TEST_ASSERT_TRUE(after.take_root(kRoot, kRoot, 200200).empty());
+
+  /* A third SceShellUI in the same boot keeps it off. */
+  Session third(dir);
+  third.start(120, 300000);
+  TEST_ASSERT_TRUE(third.disabled());
+  remove_dir(dir);
+  return 0;
+}
