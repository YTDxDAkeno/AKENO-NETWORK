diff --git a/source/shellui/include/direct_entry.hpp b/source/shellui/include/direct_entry.hpp
new file mode 100644
index 0000000..eaec39a
--- /dev/null
+++ b/source/shellui/include/direct_entry.hpp
@@ -0,0 +1,529 @@
+/* AKENO direct entry for onionHEN v0.9.0 (GPL-3.0, see LICENSE).
+ *
+ * [shortcuts] toolbox_target_mode=root: one plugin's page as the Settings root
+ * (OnionHEN?Plugin=<ID>), and the state that keeps that from outliving its
+ * Settings session. Host-testable: no Mono, and the time is passed in.
+ *
+ *   shortcut -> URI -> boot redirect (pending) -> Settings root served
+ *   -> root activated -> pushes / pops / presses -> root left (ended)
+ *
+ * Every step logs one "AKENO_DIRECT:" line (never a control id or a value). A
+ * pending request is taken once, expires after kPendingTtlMs, and any other
+ * OnionHEN route cancels it. While a session is open, kSessionFile names the
+ * SceShellUI process that holds it; a SceShellUI that starts and finds the file
+ * left by a process that ended during recent direct-entry activity turns root
+ * mode off until the console restarts (kDisabledFile; the shortcut then opens
+ * the Toolbox, link mode).
+ */
+#pragma once
+
+#include "dynamic_ui_runtime.hpp"
+#include "shellui_state.hpp"
+#include "toolbox_route.hpp"
+
+#include <onion/log.h>
+#include <onion/settings.hpp>
+#include <onion/system_tmp.h>
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <ctime>
+#include <fcntl.h>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <sys/types.h>
+#include <unistd.h>
+
+namespace toolbox::direct_entry {
+
+/* Boot redirect -> Settings root request; normally well under a second. */
+inline constexpr uint64_t kPendingTtlMs = 15000;
+/* A second shortcut this soon after a dispatch is the same request. */
+inline constexpr uint64_t kDuplicateWindowMs = 2000;
+/* A SceShellUI that ended this soon after direct-entry activity disables it. */
+inline constexpr uint64_t kRecentActivityMs = 120000;
+/* Input watch: one line per interval, for this long after the last activity. */
+inline constexpr uint64_t kWatchIntervalMs = 5000;
+inline constexpr uint64_t kWatchWindowMs = 60000;
+
+inline constexpr std::string_view kSessionFileName = "akeno_direct_session";
+inline constexpr std::string_view kDisabledFileName = "akeno_direct_disabled";
+
+enum class ShortcutAction : uint8_t {
+  Toolbox,    /**< the upstream Toolbox route */
+  PluginRoot, /**< OnionHEN?Plugin=<ID> */
+  Ignore,     /**< duplicate of a request just dispatched */
+};
+
+/** One saved session (kSessionFile). */
+struct SessionRecord {
+  int pid = 0;
+  std::string stage;
+  std::string plugin;
+  uint64_t served_ms = 0;
+  uint64_t activity_ms = 0;
+};
+
+inline uint64_t now_ms() {
+  struct timespec ts {};
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<uint64_t>(ts.tv_sec) * 1000 +
+         static_cast<uint64_t>(ts.tv_nsec / 1000000);
+}
+
+inline std::string format_record(const SessionRecord &r) {
+  char line[160];
+  std::snprintf(line, sizeof(line),
+                "pid=%d stage=%s plugin=%s served_ms=%llu activity_ms=%llu\n",
+                r.pid, r.stage.c_str(), r.plugin.c_str(),
+                static_cast<unsigned long long>(r.served_ms),
+                static_cast<unsigned long long>(r.activity_ms));
+  return line;
+}
+
+inline bool parse_record(std::string_view text, SessionRecord &out) {
+  const std::string copy(text.substr(0, 159));
+  int pid = 0;
+  char stage[24] = {};
+  char plugin[24] = {};
+  unsigned long long served = 0, activity = 0;
+  if (std::sscanf(copy.c_str(),
+                  "pid=%d stage=%23s plugin=%23s served_ms=%llu activity_ms=%llu",
+                  &pid, stage, plugin, &served, &activity) != 5)
+    return false;
+  out = {pid, stage, plugin, served, activity};
+  return true;
+}
+
+/* A file under `dir`: written whole, read up to 255 bytes. */
+inline bool write_text(const std::string &path, std::string_view text) {
+  const int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  if (fd < 0) return false;
+  const bool ok = write(fd, text.data(), text.size()) ==
+                  static_cast<ssize_t>(text.size());
+  close(fd);
+  return ok;
+}
+
+inline bool read_text(const std::string &path, std::string &out) {
+  const int fd = open(path.c_str(), O_RDONLY);
+  if (fd < 0) return false;
+  char buffer[256];
+  const ssize_t n = read(fd, buffer, sizeof(buffer) - 1);
+  close(fd);
+  if (n < 0) return false;
+  out.assign(buffer, static_cast<size_t>(n));
+  return true;
+}
+
+class Session {
+public:
+  explicit Session(std::string dir = ONION_SYSTEM_TMP_ROOT)
+      : session_file_(dir + "/" + std::string(kSessionFileName)),
+        disabled_file_(dir + "/" + std::string(kDisabledFileName)) {}
+
+  /* SceShellUI start: what a predecessor left behind. */
+  void start(int pid, uint64_t now) {
+    std::lock_guard<std::mutex> lock(mu_);
+    pid_ = pid;
+    std::string text;
+    if (read_text(disabled_file_, text)) {
+      disabled_ = true;
+      while (!text.empty() && text.back() == '\n') text.pop_back();
+      LOG_WARN("AKENO_DIRECT: root mode off until the console restarts (%s)",
+               text.c_str());
+    }
+    if (!read_text(session_file_, text)) return;
+    unlink(session_file_.c_str());
+    SessionRecord prev;
+    if (!parse_record(text, prev)) {
+      LOG_WARN("AKENO_DIRECT: unreadable session file removed");
+      return;
+    }
+    const uint64_t age = since(prev.activity_ms, now);
+    LOG_WARN("AKENO_DIRECT: SceShellUI pid=%d starts while a direct-entry "
+             "session of pid=%d was open (%s, stage %s, last activity %llu ms "
+             "into the session and %llu ms ago)",
+             pid, prev.pid, prev.plugin.c_str(), prev.stage.c_str(),
+             static_cast<unsigned long long>(
+                 since(prev.served_ms, prev.activity_ms)),
+             static_cast<unsigned long long>(age));
+    if (age <= kRecentActivityMs) {
+      char why[160];
+      std::snprintf(why, sizeof(why),
+                    "SceShellUI pid=%d ended %llu ms after direct-entry "
+                    "activity (stage %s)",
+                    prev.pid, static_cast<unsigned long long>(age),
+                    prev.stage.c_str());
+      disable_locked(why);
+    }
+  }
+
+  /* The Toolbox shortcut (`source`: l2_r3, share, long_share). */
+  ShortcutAction on_shortcut(const char *source, std::string_view target,
+                             bool root_mode, bool plugin_has_page,
+                             uint64_t now) {
+    if (target.empty()) return ShortcutAction::Toolbox;
+    std::lock_guard<std::mutex> lock(mu_);
+    const std::string id(target);
+    if (!root_mode) {
+      LOG_INFO("AKENO_DIRECT: shortcut %s -> Toolbox, %s first (link mode)",
+               source, id.c_str());
+      return ShortcutAction::Toolbox;
+    }
+    if (disabled_) {
+      LOG_WARN("AKENO_DIRECT: shortcut %s -> Toolbox, %s first (root mode off "
+               "until restart)", source, id.c_str());
+      return ShortcutAction::Toolbox;
+    }
+    if (!plugin_has_page) {
+      LOG_WARN("AKENO_DIRECT: shortcut %s -> Toolbox (%s has no page; plugin "
+               "not running?)", source, id.c_str());
+      return ShortcutAction::Toolbox;
+    }
+    if (dispatched_ms_ != 0 && since(dispatched_ms_, now) < kDuplicateWindowMs) {
+      LOG_INFO("AKENO_DIRECT: shortcut %s ignored (%llu ms after the previous "
+               "request)", source,
+               static_cast<unsigned long long>(since(dispatched_ms_, now)));
+      return ShortcutAction::Ignore;
+    }
+    dispatched_ms_ = now;
+    LOG_INFO("AKENO_DIRECT: shortcut %s -> URI OnionHEN?Plugin=%s", source,
+             id.c_str());
+    return ShortcutAction::PluginRoot;
+  }
+
+  /* Boot hook, OnionHEN?Plugin=<ID>: true when the next Settings root is the
+   * plugin's page. Either way the URI opens Settings on the Toolbox route. */
+  bool on_plugin_uri(std::string_view id, bool root_mode, uint64_t now) {
+    std::lock_guard<std::mutex> lock(mu_);
+    const std::string plugin(id);
+    if (open_locked()) end_locked("a new request replaced it", now);
+    if (!root_mode || disabled_) {
+      stage_ = Stage::Idle;
+      LOG_INFO("AKENO_DIRECT: URI for %s -> Toolbox root (%s)", plugin.c_str(),
+               disabled_ ? "root mode off until restart" : "link mode");
+      return false;
+    }
+    stage_ = Stage::Pending;
+    plugin_ = plugin;
+    pending_ms_ = now;
+    LOG_INFO("AKENO_DIRECT: boot redirect -> Settings, %s pending as its root",
+             plugin.c_str());
+    return true;
+  }
+
+  /* Boot hook: another OnionHEN route replaces a pending request. */
+  void cancel_pending(const char *route) {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (stage_ != Stage::Pending) return;
+    stage_ = Stage::Idle;
+    LOG_INFO("AKENO_DIRECT: pending %s cancelled by %s", plugin_.c_str(), route);
+  }
+
+  /* Resource hook: the plugin whose root page this Settings root shows, once;
+   * empty for every other resource, an expired request or no request. A
+   * Settings root served another way ends an open session. */
+  std::string take_root(std::string_view resource, std::string_view settings_root,
+                        uint64_t now) {
+    if (settings_root.empty() || resource != settings_root) return {};
+    std::lock_guard<std::mutex> lock(mu_);
+    if (stage_ == Stage::Pending) {
+      stage_ = Stage::Idle;
+      const uint64_t age = since(pending_ms_, now);
+      if (age > kPendingTtlMs) {
+        LOG_WARN("AKENO_DIRECT: request for %s expired after %llu ms -> "
+                 "Toolbox root", plugin_.c_str(),
+                 static_cast<unsigned long long>(age));
+        return {};
+      }
+      LOG_INFO("AKENO_DIRECT: Settings root requested %llu ms after the "
+               "redirect", static_cast<unsigned long long>(age));
+      return plugin_;
+    }
+    if (open_locked()) end_locked("the Settings root was opened again", now);
+    return {};
+  }
+
+  void root_served(std::string_view id, uint64_t now) {
+    std::lock_guard<std::mutex> lock(mu_);
+    stage_ = Stage::RootServed;
+    plugin_ = std::string(id);
+    served_ms_ = now;
+    LOG_INFO("AKENO_DIRECT: %s root page served as the Settings root "
+             "(setting_list id_debug_settings, fresh page stack)",
+             plugin_.c_str());
+    touch_locked(now);
+  }
+
+  void root_failed(std::string_view id, const char *why) {
+    std::lock_guard<std::mutex> lock(mu_);
+    stage_ = Stage::Idle;
+    const std::string plugin(id);
+    LOG_WARN("AKENO_DIRECT: %s root unavailable (%s) -> Toolbox root",
+             plugin.c_str(), why);
+  }
+
+  /* SettingPage.OnActivated: the first activation after the root was served
+   * is the root itself; it has the Settings focus from here on. */
+  void page_activated(int transition, uint64_t now) {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (stage_ != Stage::RootServed) return;
+    stage_ = Stage::Active;
+    LOG_INFO("AKENO_DIRECT: root activated (transition %d, %llu ms after it "
+             "was served); input goes to %s", transition,
+             static_cast<unsigned long long>(since(served_ms_, now)),
+             plugin_.c_str());
+    touch_locked(now);
+  }
+
+  /* Resource hook: a plugin page was shown; `depth` pages are open. */
+  void navigated(size_t depth, uint64_t now) {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (!open_locked()) return;
+    LOG_INFO("AKENO_DIRECT: page shown, depth %zu", depth);
+    touch_locked(now);
+  }
+
+  /* SettingPageStack.OnPopping on a plugin page; `depth` pages remain. */
+  void popped(size_t depth, uint64_t now) {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (!open_locked()) return;
+    if (depth == 0) {
+      end_locked("root left, Settings closing", now);
+      return;
+    }
+    LOG_INFO("AKENO_DIRECT: page popped, depth %zu", depth);
+    touch_locked(now);
+  }
+
+  /* SettingPage.OnPressed on a plugin page. */
+  void pressed(const char *outcome, size_t depth, uint64_t now) {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (!open_locked()) return;
+    LOG_INFO("AKENO_DIRECT: press at depth %zu -> %s", depth, outcome);
+    touch_locked(now);
+  }
+
+  /* GamePad.GetData after a session: ShellUI still reads the pad, and whether
+   * the buttons change. One relaxed load per frame otherwise. */
+  bool watching() const {
+    return watch_until_ms_.load(std::memory_order_relaxed) != 0;
+  }
+
+  void pad_frame(uint32_t buttons, uint64_t now) {
+    const uint64_t until = watch_until_ms_.load(std::memory_order_relaxed);
+    if (until == 0) return;
+    frames_.fetch_add(1, std::memory_order_relaxed);
+    if (last_buttons_.exchange(buttons, std::memory_order_relaxed) != buttons)
+      changes_.fetch_add(1, std::memory_order_relaxed);
+    uint64_t next = next_report_ms_.load(std::memory_order_relaxed);
+    if (now < next ||
+        !next_report_ms_.compare_exchange_strong(next, now + kWatchIntervalMs))
+      return;
+    const unsigned frames = frames_.exchange(0, std::memory_order_relaxed);
+    const unsigned changes = changes_.exchange(0, std::memory_order_relaxed);
+    if (now >= until) {
+      uint64_t expected = until;
+      if (watch_until_ms_.compare_exchange_strong(expected, 0))
+        LOG_INFO("AKENO_DIRECT: input watch done: ShellUI reads the pad "
+                 "(%u reads, %u button changes in the last interval)",
+                 frames, changes);
+      return;
+    }
+    LOG_INFO("AKENO_DIRECT: ShellUI reads the pad: %u reads, %u button "
+             "changes in the last interval", frames, changes);
+  }
+
+  bool disabled() const {
+    std::lock_guard<std::mutex> lock(mu_);
+    return disabled_;
+  }
+
+  /* Test hook: whether a session is open (root served, not left). */
+  bool open() const {
+    std::lock_guard<std::mutex> lock(mu_);
+    return open_locked();
+  }
+
+  const std::string &session_file() const { return session_file_; }
+  const std::string &disabled_file() const { return disabled_file_; }
+
+private:
+  enum class Stage : uint8_t { Idle, Pending, RootServed, Active };
+
+  static const char *stage_name(Stage stage) {
+    switch (stage) {
+    case Stage::Pending: return "pending";
+    case Stage::RootServed: return "root_served";
+    case Stage::Active: return "active";
+    case Stage::Idle: break;
+    }
+    return "idle";
+  }
+
+  /* Elapsed time; 0 when the clock reads earlier than `from`. */
+  static uint64_t since(uint64_t from, uint64_t now) {
+    return now >= from ? now - from : 0;
+  }
+
+  bool open_locked() const {
+    return stage_ == Stage::RootServed || stage_ == Stage::Active;
+  }
+
+  /* Activity: the session file and the input watch follow it. */
+  void touch_locked(uint64_t now) {
+    activity_ms_ = now;
+    const SessionRecord record{pid_, stage_name(stage_), plugin_, served_ms_,
+                               now};
+    if (!write_text(session_file_, format_record(record)))
+      LOG_WARN("AKENO_DIRECT: cannot write %s", session_file_.c_str());
+    watch_locked(now);
+  }
+
+  void watch_locked(uint64_t now) {
+    if (watch_until_ms_.load(std::memory_order_relaxed) == 0) {
+      next_report_ms_.store(now + kWatchIntervalMs, std::memory_order_relaxed);
+      frames_.store(0, std::memory_order_relaxed);
+      changes_.store(0, std::memory_order_relaxed);
+    }
+    watch_until_ms_.store(now + kWatchWindowMs, std::memory_order_relaxed);
+  }
+
+  void end_locked(const char *why, uint64_t now) {
+    LOG_INFO("AKENO_DIRECT: session ended (%s) after %llu ms; watching input "
+             "for %llu s", why,
+             static_cast<unsigned long long>(since(served_ms_, now)),
+             static_cast<unsigned long long>(kWatchWindowMs / 1000));
+    stage_ = Stage::Idle;
+    unlink(session_file_.c_str());
+    watch_locked(now);
+  }
+
+  void disable_locked(const char *why) {
+    disabled_ = true;
+    stage_ = Stage::Idle;
+    write_text(disabled_file_, std::string(why) + "\n");
+    LOG_WARN("AKENO_DIRECT: root mode off until the console restarts: %s; the "
+             "shortcut opens the Toolbox", why);
+  }
+
+  mutable std::mutex mu_;
+  const std::string session_file_;
+  const std::string disabled_file_;
+  int pid_ = 0;
+  Stage stage_ = Stage::Idle;
+  std::string plugin_;
+  uint64_t dispatched_ms_ = 0;
+  uint64_t pending_ms_ = 0;
+  uint64_t served_ms_ = 0;
+  uint64_t activity_ms_ = 0;
+  bool disabled_ = false;
+  std::atomic<uint64_t> watch_until_ms_{0};
+  std::atomic<uint64_t> next_report_ms_{0};
+  std::atomic<unsigned> frames_{0};
+  std::atomic<unsigned> changes_{0};
+  std::atomic<uint32_t> last_buttons_{0};
+};
+
+/** The SceShellUI process's session. */
+inline Session &shared_session() {
+  static Session session;
+  return session;
+}
+
+/* ---- Hook steps (the Mono hooks call these; host tests drive them) ---- */
+
+/** GoToToolboxShortcutTarget: the URI to open, empty for none. */
+inline std::string shortcut_uri(Session &session, const char *source,
+                                const onion::Settings &settings,
+                                std::string_view toolbox_uri, uint64_t now) {
+  const std::string &target = settings.toolbox_shortcut_target;
+  const bool plugin_has_page =
+      !target.empty() &&
+      !onion::shellui::dynamic_ui::plugin_root_title(target).empty();
+  switch (session.on_shortcut(source, target,
+                              settings.toolbox_target_mode ==
+                                  onion::kToolboxTargetRoot,
+                              plugin_has_page, now)) {
+  case ShortcutAction::PluginRoot:
+    return plugin_page_uri(target);
+  case ShortcutAction::Ignore:
+    return {};
+  case ShortcutAction::Toolbox:
+    break;
+  }
+  return std::string(toolbox_uri);
+}
+
+/** Boot hook, OnionHEN?Plugin=<ID>: the newest request wins over a Cheats
+ * flag; without root mode the URI opens the Toolbox root. */
+inline void accept_plugin_uri(Session &session, ToolboxUiState &ui,
+                              std::string_view plugin_id,
+                              const onion::Settings &settings, uint64_t now) {
+  ui.clear_cheat_shortcuts();
+  session.on_plugin_uri(plugin_id,
+                        settings.toolbox_target_mode == onion::kToolboxTargetRoot,
+                        now);
+}
+
+/** GetManifestResourceStream_Hook: true with `out_xml` when `resource` is a
+ * plugin page. The Settings root of a pending request is the plugin's root
+ * page (no parent to restore); a plugin page that fails to render leaves the
+ * resource to the Toolbox route. Any other Settings root starts with no plugin
+ * page open: Settings may have closed on a plugin page without a pop. */
+inline bool serve_plugin_page(Session &session, ToolboxUiState &ui,
+                              std::string_view resource,
+                              std::string_view settings_root,
+                              std::string &out_xml, uint64_t now) {
+  namespace dyn = onion::shellui::dynamic_ui;
+  if (const std::string plugin = session.take_root(resource, settings_root, now);
+      !plugin.empty()) {
+    if (dyn::render_plugin_root(plugin, out_xml)) {
+      session.root_served(plugin, now);
+      ui.enter_settings_root(Page::DynamicPlugin);
+      return true;
+    }
+    session.root_failed(plugin, "no renderable root page");
+  }
+  if (!settings_root.empty() && resource == settings_root) {
+    if (dyn::page_depth() != 0)
+      LOG_INFO("AKENO_DIRECT: %zu plugin page(s) left open by an earlier "
+               "Settings session dropped", dyn::page_depth());
+    dyn::clear_page_stack();
+    return false;
+  }
+  if (!dyn::render_resource(resource, out_xml)) return false;
+  ui.set_active_page(Page::DynamicPlugin);
+  session.navigated(dyn::page_depth(), now);
+  return true;
+}
+
+/** SettingPageStack.OnPopping while a plugin page is active. */
+inline void leave_plugin_page(Session &session, ToolboxUiState &ui,
+                              uint64_t now) {
+  namespace dyn = onion::shellui::dynamic_ui;
+  const bool dynamic_parent = dyn::leave_active_page();
+  if (!dynamic_parent) ui.leave_page(Page::DynamicPlugin);
+  LOG_DEBUG("dynamic_plugin_xml: page popped; dynamic_parent=%d",
+            dynamic_parent ? 1 : 0);
+  session.popped(dyn::page_depth(), now);
+}
+
+/** SettingPage.OnPressed on a plugin page: the press goes to the plugin. */
+inline onion::shellui::dynamic_ui::DispatchResult
+press_plugin_control(Session &session, std::string_view control_id,
+                     std::string_view value, uint64_t now) {
+  namespace dyn = onion::shellui::dynamic_ui;
+  const dyn::DispatchResult result = dyn::dispatch_control(control_id, value);
+  session.pressed(result == dyn::DispatchResult::Accepted ? "sent to the plugin"
+                  : result == dyn::DispatchResult::Unavailable
+                      ? "plugin unavailable"
+                      : "Settings (not a plugin control)",
+                  dyn::page_depth(), now);
+  return result;
+}
+
+} // namespace toolbox::direct_entry
