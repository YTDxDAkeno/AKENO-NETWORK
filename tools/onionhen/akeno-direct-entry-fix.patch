+/* 12: config keys are compatible both ways. */
+int test_config_compatibility() {
+  onion::Settings defaults{};
+  TEST_ASSERT_EQ_INT(onion::kToolboxTargetLink, defaults.toolbox_target_mode);
+  const std::string text = onion::settings_serialize(defaults);
+  TEST_ASSERT_TRUE(text.find("\ntoolbox_target_mode=link\n") != std::string::npos);
+
+  onion::Settings s;
+  /* The owner's working F0 config (original onionHEN). */
+  TEST_ASSERT_TRUE(!load_config("[meta]\nschema_version=1\n\n[shortcuts]\n"
+                                "cheats_menu=off\ntoolbox=l2_r3\n", s).empty());
+  TEST_ASSERT_EQ_INT(1, s.toolbox_shortcut_opt);
+  TEST_ASSERT_TRUE(s.toolbox_shortcut_target.empty());
+  TEST_ASSERT_EQ_INT(onion::kToolboxTargetLink, s.toolbox_target_mode);
+  /* PR #16's config: the same keys now mean link mode. */
+  TEST_ASSERT_TRUE(!load_config("[meta]\nschema_version=1\n\n[game_menu]\n"
+                                "show_onionhen_options=true\nplugin_entry=AKEN00001\n\n"
+                                "[shortcuts]\ncheats_menu=off\ntoolbox=l2_r3\n"
+                                "toolbox_target=AKEN00001\n", s).empty());
+  TEST_ASSERT_STREQ("AKEN00001", s.toolbox_shortcut_target.c_str());
+  TEST_ASSERT_EQ_INT(onion::kToolboxTargetLink, s.toolbox_target_mode);
+  struct Case {
+    const char *value;
+    int want;
+  } cases[] = {{"root", onion::kToolboxTargetRoot}, {"ROOT", onion::kToolboxTargetRoot},
+               {"link", onion::kToolboxTargetLink}, {"direct", onion::kToolboxTargetLink},
+               {"", onion::kToolboxTargetLink},     {"1", onion::kToolboxTargetLink}};
+  for (const Case &c : cases) {
+    char body[256];
+    std::snprintf(body, sizeof(body),
+                  "[meta]\nschema_version=1\n\n[shortcuts]\ntoolbox=l2_r3\n"
+                  "toolbox_target=AKEN00001\ntoolbox_target_mode=%s\n", c.value);
+    TEST_ASSERT_TRUE(!load_config(body, s).empty());
+    TEST_ASSERT_EQ_INT(c.want, s.toolbox_target_mode);
+    /* What the Toolbox writes back keeps the choice. */
+    onion::Settings again;
+    TEST_ASSERT_TRUE(!load_config(onion::settings_serialize(s).c_str(), again).empty());
+    TEST_ASSERT_EQ_INT(c.want, again.toolbox_target_mode);
+    TEST_ASSERT_STREQ("AKEN00001", again.toolbox_shortcut_target.c_str());
+  }
+  return 0;
+}
