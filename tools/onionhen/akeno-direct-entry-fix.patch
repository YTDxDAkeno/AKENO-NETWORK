+/* 9: hooks on several threads (input, boot, resources, pops) never corrupt the
+ * session; run under ASan/UBSan (and TSan in CI). */
+int test_concurrent_hooks() {
+  const std::string dir = make_dir();
+  Session session(dir);
+  std::atomic<bool> stop{false};
+  std::atomic<uint64_t> clock{1000};
+  std::vector<std::thread> threads;
+  threads.emplace_back([&] {
+    while (!stop) {
+      const uint64_t now = clock.fetch_add(7);
+      (void)session.on_shortcut("l2_r3", "AKEN00001", true, true, now);
+      if (session.on_plugin_uri("AKEN00001", true, now))
+        session.cancel_pending("OnionHEN?Cheats");
+    }
+  });
+  threads.emplace_back([&] {
+    while (!stop) {
+      const uint64_t now = clock.fetch_add(5);
+      (void)session.on_plugin_uri("AKEN00001", true, now);
+      const std::string plugin = session.take_root(kRoot, kRoot, now);
+      if (!plugin.empty()) session.root_served(plugin, now);
+      session.navigated(2, now);
+    }
+  });
+  threads.emplace_back([&] {
+    while (!stop) {
+      const uint64_t now = clock.fetch_add(3);
+      session.page_activated(1, now);
+      session.pressed("sent to the plugin", 1, now);
+      session.popped(now % 2, now);
+    }
+  });
+  threads.emplace_back([&] {
+    for (uint32_t i = 0; !stop; ++i)
+      if (session.watching()) session.pad_frame(i, clock.load());
+  });
+  for (int i = 0; i < 200; ++i) usleep(1000);
+  stop = true;
+  for (std::thread &t : threads) t.join();
+  /* Whatever state it ended in, the next Settings root is consistent. */
+  (void)session.take_root(kRoot, kRoot, clock.load() + de::kPendingTtlMs + 1);
+  TEST_ASSERT_TRUE(!session.open());
+  TEST_ASSERT_TRUE(!exists(session.session_file()));
+  remove_dir(dir);
+  return 0;
+}
