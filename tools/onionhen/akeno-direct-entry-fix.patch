+using toolbox::direct_entry::Session;
+using toolbox::direct_entry::ShortcutAction;
+namespace de = toolbox::direct_entry;
+
+namespace {
+
+constexpr const char *kRoot = "debug_settings.xml";
+constexpr const char *kToolboxUri = "pssettings:play?mode=settings&function=debug_settings_old";
+
+std::string make_dir() {
+  char path[] = "/tmp/onion-direct-XXXXXX";
+  return mkdtemp(path) ? std::string(path) : std::string();
+}
+
+bool exists(const std::string &path) {
+  struct stat st {};
+  return stat(path.c_str(), &st) == 0;
+}
+
+void remove_dir(const std::string &dir) {
+  unlink((dir + "/" + std::string(de::kSessionFileName)).c_str());
+  unlink((dir + "/" + std::string(de::kDisabledFileName)).c_str());
+  rmdir(dir.c_str());
+}
+
+std::string load_config(const char *body, onion::Settings &out) {
+  char path[] = "/tmp/onion-direct-config-XXXXXX";
+  const int fd = mkstemp(path);
+  if (fd < 0) return {};
+  const std::string text(body);
+  const bool ok = write(fd, text.data(), text.size()) ==
+                  static_cast<ssize_t>(text.size());
+  close(fd);
+  out = onion::Settings{};
+  const bool loaded = ok && onion::settings_load_file(path, &out);
+  unlink(path);
+  return loaded ? std::string(path) : std::string();
+}
+
+/* 1, 3: the Toolbox shortcut keeps the upstream route unless root mode is on
+ * and the plugin has a page. */
+int test_shortcut_keeps_toolbox_route() {
+  onion::shellui::dynamic_ui::replace_snapshot({});
+  const std::string dir = make_dir();
+  TEST_ASSERT_TRUE(!dir.empty());
+  Session session(dir);
+  onion::Settings settings{};
+  /* Upstream config: no target. */
+  { const std::string got_ = de::shortcut_uri(session, "l2_r3", settings, kToolboxUri, 1000); TEST_ASSERT_STREQ(kToolboxUri, got_.c_str()); }
+  /* PR #16's config (target, no mode) is link mode now: the Toolbox route. */
+  settings.toolbox_shortcut_target = "AKEN00001";
+  TEST_ASSERT_EQ_INT(onion::kToolboxTargetLink, settings.toolbox_target_mode);
+  { const std::string got_ = de::shortcut_uri(session, "l2_r3", settings, kToolboxUri, 2000); TEST_ASSERT_STREQ(kToolboxUri, got_.c_str()); }
+  { const std::string got_ = de::shortcut_uri(session, "share", settings, kToolboxUri, 2100); TEST_ASSERT_STREQ(kToolboxUri, got_.c_str()); }
+  /* Root mode without a plugin page (plugin not running): the Toolbox. */
+  settings.toolbox_target_mode = onion::kToolboxTargetRoot;
+  { const std::string got_ = de::shortcut_uri(session, "l2_r3", settings, kToolboxUri, 5000); TEST_ASSERT_STREQ(kToolboxUri, got_.c_str()); }
+  /* Nothing was armed by any of these. */
+  TEST_ASSERT_TRUE(session.take_root(kRoot, kRoot, 5100).empty());
+  TEST_ASSERT_TRUE(!session.open());
+  remove_dir(dir);
+  return 0;
+}
