diff --git a/source/util/tests/test_x64_relocator.cpp b/source/util/tests/test_x64_relocator.cpp
index b4152fd..1d1166c 100644
--- a/source/util/tests/test_x64_relocator.cpp
+++ b/source/util/tests/test_x64_relocator.cpp
@@ -170,6 +170,50 @@ int test_loop_relative_rejected() {
 
 } // namespace
 
+/* A second injection over an earlier detour (jmp [rip+0]; dq hook) must chain
+ * to that hook for every hook address, not depend on how its bytes decode
+ * (AKENO: the PR #14 host failed "relocation failed at +6" this way). */
+int test_existing_detour_chains_for_any_address() {
+  constexpr uintptr_t source_address = 0x900123450;
+  constexpr uintptr_t destination_address = 0x900023450;
+  for (uint64_t base = 0x800000000ull; base < 0x2000000000ull;
+       base += 0x4000ull * 977) {
+    for (uint64_t offset = 0; offset < 0x40000; offset += 0x10 * 37) {
+      const uint64_t hook = base + offset;
+      uint8_t source[28];
+      std::memset(source, 0x90, sizeof(source));
+      const uint8_t jump[] = {0xff, 0x25, 0, 0, 0, 0};
+      std::memcpy(source, jump, sizeof(jump));
+      std::memcpy(source + sizeof(jump), &hook, sizeof(hook));
+      uint8_t destination[ONION_X64_TRAMPOLINE_CAPACITY];
+      onion_x64_relocate_result result{};
+      TEST_ASSERT_TRUE(relocate(source, 14, source_address, destination_address,
+                                destination, result));
+      TEST_ASSERT_EQ_INT(14, static_cast<int>(result.source_size));
+      TEST_ASSERT_MEMEQ(source, destination, 14);
+      TEST_ASSERT_EQ_U64(hook, read_u64(destination + 6));
+    }
+  }
+  return 0;
+}
+
+/* The same patch after a short first instruction is still one unit. */
+int test_existing_detour_after_instruction() {
+  const uint64_t hook = 0x8000318e8ull;
+  uint8_t source[28];
+  std::memset(source, 0x90, sizeof(source));
+  const uint8_t prefix[] = {0x55, 0xff, 0x25, 0, 0, 0, 0};
+  std::memcpy(source, prefix, sizeof(prefix));
+  std::memcpy(source + sizeof(prefix), &hook, sizeof(hook));
+  uint8_t destination[ONION_X64_TRAMPOLINE_CAPACITY];
+  onion_x64_relocate_result result{};
+  TEST_ASSERT_TRUE(relocate(source, 14, 0x10000000, 0x20000000, destination,
+                            result));
+  TEST_ASSERT_EQ_INT(15, static_cast<int>(result.source_size));
+  TEST_ASSERT_MEMEQ(source, destination, 15);
+  return 0;
+}
+
