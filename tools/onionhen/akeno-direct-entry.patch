diff --git a/source/libonion_detour/source/x64_relocator.cpp b/source/libonion_detour/source/x64_relocator.cpp
index 4ce12fc..5eb1b31 100644
--- a/source/libonion_detour/source/x64_relocator.cpp
+++ b/source/libonion_detour/source/x64_relocator.cpp
@@ -30,6 +30,8 @@ struct RelocatedInstruction {
   size_t destination_size = 0;
   BranchKind branch = BranchKind::None;
   uint8_t condition = 0;
+  /* jmp [rip+0]; dq target — copied verbatim, see is_absolute_jump_patch. */
+  bool absolute_jump_patch = false;
 };
 
 void set_error(onion_x64_relocate_result *result,
@@ -51,6 +53,17 @@ size_t immediate_size(const hde64s &decoded) {
   return size;
 }
 
+/* The 14-byte absolute jump of write_absolute_jump and
+ * onion_x64_build_atomic_patch: what a detour of an earlier injection leaves at
+ * a function entry. Its RIP-relative operand addresses its own last 8 bytes,
+ * so the 14 bytes are position-independent as one unit. Decoding them as
+ * jmp [rip+0] followed by the hook address as instructions makes the outcome
+ * depend on the address bytes, i.e. on the build layout. */
+bool is_absolute_jump_patch(const uint8_t *code) {
+  static constexpr uint8_t prefix[] = {0xff, 0x25, 0, 0, 0, 0};
+  return std::memcmp(code, prefix, sizeof(prefix)) == 0;
+}
+
 bool is_rip_relative_memory(const hde64s &decoded) {
   return (decoded.flags & F_MODRM) && decoded.modrm_mod == 0 &&
          decoded.modrm_rm == 5 && decoded.p_67 == 0;
@@ -246,6 +259,14 @@ extern "C" bool onion_x64_relocate(
     RelocatedInstruction &instruction = instructions[instruction_count];
     instruction.source_offset = source_size;
     instruction.destination_offset = destination_size;
+    if (is_absolute_jump_patch(source + source_size)) {
+      instruction.absolute_jump_patch = true;
+      instruction.destination_size = kAbsoluteJumpSize;
+      source_size += kAbsoluteJumpSize;
+      destination_size += kAbsoluteJumpSize;
+      ++instruction_count;
+      continue;
+    }
     const unsigned decoded_size =
         hde64_disasm(source + source_size, &instruction.decoded);
     if (decoded_size == 0 || (instruction.decoded.flags & F_ERROR)) {
@@ -272,6 +293,10 @@ extern "C" bool onion_x64_relocate(
   for (size_t i = 0; i < instruction_count; ++i) {
     const RelocatedInstruction &instruction = instructions[i];
     uint8_t *output = destination + instruction.destination_offset;
+    if (instruction.absolute_jump_patch) {
+      std::memcpy(output, source + instruction.source_offset, kAbsoluteJumpSize);
+      continue;
+    }
     if (instruction.branch == BranchKind::None) {
       std::memcpy(output, source + instruction.source_offset,
                   instruction.decoded.len);
