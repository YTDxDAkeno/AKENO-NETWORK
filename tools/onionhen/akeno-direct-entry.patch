+/* AKENO direct entry: [shortcuts] toolbox_target and [game_menu] plugin_entry.
+ * Defaults are the upstream behaviour and an upstream config needs no edit. */
+static int test_plugin_targets_parse_policy(void) {
+  onion::Settings defaults{};
+  TEST_ASSERT_TRUE(defaults.toolbox_shortcut_target.empty());
+  TEST_ASSERT_TRUE(defaults.game_menu_plugin_entry.empty());
+  const std::string text = onion::settings_serialize(defaults);
+  TEST_ASSERT_TRUE(text.find("\ntoolbox_target=toolbox\n") != std::string::npos);
+  TEST_ASSERT_TRUE(text.find("\nplugin_entry=none\n") != std::string::npos);
+
+  struct Case {
+    const char *toolbox_target;
+    const char *plugin_entry;
+    const char *want_target;
+    const char *want_entry;
+  };
+  const Case cases[] = {
+      {"AKEN00001", "AKEN00001", "AKEN00001", "AKEN00001"},
+      {"toolbox", "none", "", ""},
+      {"TOOLBOX", "None", "", ""},
+      {"AKEN0001", "AKEN000011", "", ""},       /* wrong length: default */
+      {"AKEN-0001", "../../../x", "", ""},      /* not alphanumeric: default */
+      {"", "", "", ""},
+  };
+  for (const Case &c : cases) {
+    std::string path = temp_ini_path();
+    TEST_ASSERT_TRUE(!path.empty());
+    FILE *f = fopen(path.c_str(), "w");
+    TEST_ASSERT_TRUE(f != nullptr);
+    fprintf(f,
+            "[meta]\nschema_version=1\n\n[shortcuts]\ntoolbox=l2_r3\n"
+            "toolbox_target=%s\n\n[game_menu]\nplugin_entry=%s\n",
+            c.toolbox_target, c.plugin_entry);
+    fclose(f);
+    onion::Settings out{};
+    TEST_ASSERT_TRUE(onion::settings_load_file(path.c_str(), &out));
+    TEST_ASSERT_EQ_INT(1, out.toolbox_shortcut_opt);
+    TEST_ASSERT_STREQ(c.want_target, out.toolbox_shortcut_target.c_str());
+    TEST_ASSERT_STREQ(c.want_entry, out.game_menu_plugin_entry.c_str());
+
+    /* What the Toolbox writes back keeps the choice. */
+    TEST_ASSERT_TRUE(onion::settings_save_file(path.c_str(), out));
+    onion::Settings again{};
+    TEST_ASSERT_TRUE(onion::settings_load_file(path.c_str(), &again));
+    TEST_ASSERT_STREQ(out.toolbox_shortcut_target.c_str(),
+                      again.toolbox_shortcut_target.c_str());
+    TEST_ASSERT_STREQ(out.game_menu_plugin_entry.c_str(),
+                      again.game_menu_plugin_entry.c_str());
+    unlink(path.c_str());
+  }
+  return 0;
+}
+
