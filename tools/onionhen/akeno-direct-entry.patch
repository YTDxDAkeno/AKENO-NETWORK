+/* Direct entry into one plugin's pages: the boot-URI hook redirects
+ * "OnionHEN?Plugin=<ID>" to the Toolbox route (like OnionHEN?Cheats) and the
+ * resource hook then serves that plugin's root page as the Settings root. */
+inline constexpr std::string_view kPluginPageUriPrefix = "OnionHEN?Plugin=";
+
+/** The plugin ID of an "OnionHEN?Plugin=<ID>" URI; empty for any other URI. */
+inline std::string_view parse_plugin_page_uri(std::string_view uri) {
+  if (!uri.starts_with(kPluginPageUriPrefix))
+    return {};
+  const std::string_view id = uri.substr(kPluginPageUriPrefix.size());
+  return valid_external_plugin_id(id) ? id : std::string_view{};
+}
+
+inline std::string plugin_page_uri(std::string_view plugin_id) {
+  return std::string(kPluginPageUriPrefix) + std::string(plugin_id);
+}
+
+/** A pending direct entry replaces only the Settings root the redirect opens. */
+inline bool direct_plugin_takes_resource(std::string_view resource,
+                                         std::string_view debug_settings_xml,
+                                         std::string_view pending_plugin_id) {
+  return !pending_plugin_id.empty() && !debug_settings_xml.empty() &&
+         resource == debug_settings_xml;
+}
+
 inline bool valid_sprx_config_id(std::string_view id) {
   if (id.empty() || id.size() >= 32)
     return false;
